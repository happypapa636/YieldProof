# Postgres (Neon) — provided automatically by the Vercel Neon integration.
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# HS256 secret for SIWE session JWTs (generate 48 random bytes, base64url).
SESSION_SECRET=
# Bearer secret Vercel Cron sends to /api/cron/snapshot.
CRON_SECRET=
# Optional RPC overrides (public defaults are used when unset).
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
MEZO_MAINNET_RPC_URL=https://mezo.drpc.org
MEZO_MAINNET_LOGS_RPC_URL=https://mainnet.mezo.public.validationcloud.io
# Optional: canonical public URL used for SIWE domain checks and OG links.
NEXT_PUBLIC_SITE_URL=https://yieldproof-mezo.vercel.app
